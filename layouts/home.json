{{- $s := newScratch -}}
{{- $usPath := printf "/%s/%s" "country" "united-states" -}}
{{- $usPage := $.Site.GetPage $usPath -}}
{{- $canadaPath := printf "/%s/%s" "country" "canada" -}}
{{- $canadaPage := $.Site.GetPage $canadaPath -}}
{{- $mexicoPath :=  printf "/%s/%s" "country" "mexico" -}}
{{- $mexicoPage := $.Site.GetPage $mexicoPath -}}
{{- $costaRicaPath :=  printf "/%s/%s" "country" "costa-rica" -}}
{{- $costaRicaPage := $.Site.GetPage $costaRicaPath -}}

{{- range (slice $usPage $canadaPage $mexicoPage $costaRicaPage) -}}
{{- $st := newScratch -}}
{{- with .Params.states -}}
{{- range . -}}
{{- $statepath := printf "/%s/%s" "state" .slug -}}
{{- with $.Site.GetPage $statepath -}}
{{- $feat := newScratch -}}
{{- with .Params.featured -}}
{{- $signPath := printf "/%s/%s" "sign" . -}}
{{- with $.Site.GetPage $signPath -}}
{{- $feat.SetInMap "image" "original" (printf "%s%s/%s.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- if .Params.hasProcessed -}}
{{- $feat.SetInMap "image" "large" (printf "%s%s/edited/%s_l.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $feat.SetInMap "image" "medium" (printf "%s%s/edited/%s_m.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $feat.SetInMap "image" "small" (printf "%s%s/edited/%s_s.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $feat.SetInMap "image" "thumbnail" (printf "%s%s/edited/%s_t.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- else -}}
{{- $feat.SetInMap "image" "large" (printf "%s%s/%s_l.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $feat.SetInMap "image" "medium" (printf "%s%s/%s_m.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $feat.SetInMap "image" "small" (printf "%s%s/%s_s.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $feat.SetInMap "image" "thumbnail" (printf "%s%s/%s_t.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $st.Add "states" (slice (dict "imageCount"  .Params.imageCount "name" .Params.name "slug" .Params.slug "featured" ($feat.Get "image") "url" (printf "%s%s" .Permalink "index.json") ) ) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- $feat := newScratch -}}
{{- with .Params.featured -}}
{{- $signPath := printf "/%s/%s" "sign" . -}}
{{- with $.Site.GetPage $signPath -}}
{{- $feat.SetInMap "image" "original" (printf "%s%s/%s.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- if .Params.hasProcessed -}}
{{- $feat.SetInMap "image" "large" (printf "%s%s/edited/%s_l.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $feat.SetInMap "image" "medium" (printf "%s%s/edited/%s_m.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $feat.SetInMap "image" "small" (printf "%s%s/edited/%s_s.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $feat.SetInMap "image" "thumbnail" (printf "%s%s/edited/%s_t.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- else -}}
{{- $feat.SetInMap "image" "large" (printf "%s%s/%s_l.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $feat.SetInMap "image" "medium" (printf "%s%s/%s_m.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $feat.SetInMap "image" "small" (printf "%s%s/%s_s.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $feat.SetInMap "image" "thumbnail" (printf "%s%s/%s_t.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- end -}}
{{- end -}}
{{- end -}}



{{ $s.Add "countries" (slice (dict "imageCount" .Params.imageCount  "states" ($st.Get "states" ) "name" .Params.name "slug" .Params.slug "subdivisionName" .Params.subdivisionname "featured" ($feat.Get "image") "url" (printf "%s%s" .Permalink "index.json") ) )}}
{{- end -}}

{{- $s.Add "imageCount" .Site.Data.images.imageCount -}}

{{- $s.Values  | jsonify -}}
