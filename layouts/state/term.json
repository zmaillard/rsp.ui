{{- $p := newScratch -}}
{{- $p.Add "name" .Params.name -}}
{{- $p.Add "slug" .Params.slug -}}
{{- $p.Add "imageCount" .Params.imagecount -}}
{{- $p.Add "subdivisionName" .Params.subdivisionname -}}
{{- $stateSlug := .Params.slug -}}
{{- range .Params.counties -}}
{{- $countypath := printf "/%s/%s_%s" "county" $stateSlug .slug -}}
{{- with $.Site.GetPage $countypath -}}
{{- $c := dict "imageCount" .Params.imageCount "name" .Params.name "slug" (printf "%s_%s" .Params.stateslug .Params.slug) "url" (printf "%s%s" .Permalink "index.json") -}}
{{- $p.Add "stateSubdivisions" (slice $c) -}}
{{- end -}}
{{- end -}}
{{- range .Params.places -}}
{{ $placepath := printf "/%s/%s_%s" "place" $stateSlug .slug }}
{{- with $.Site.GetPage $placepath -}}
{{- $pl := dict "imageCount" .Params.imageCount "name" .Params.name "slug" (printf "%s_%s" .Params.stateslug .Params.slug) "url" (printf "%s%s" .Permalink "index.json") -}}
{{- $p.Add "places" (slice $pl) -}}
{{- end -}}
{{- end -}}
{{- range .Params.highways -}}
{{ $highwaypath := printf "/%s/%s" "highway" . }}
{{- with $.Site.GetPage $highwaypath -}}
{{- $shieldDict := dict "small"  (printf "%sShields/20x/%s" site.Params.SHIELDBASEURL .Params.imagename ) "large"  (printf "%sShields/%s" site.Params.SHIELDBASEURL .Params.imagename ) -}}
{{- $hw := dict "shield" $shieldDict "name" .Params.name "slug" .Params.slug "url" (printf "%s%s" .Permalink "index.json") -}}
{{- $p.Add "highways" (slice $hw) -}}
{{- end -}}
{{- end -}}

{{- $p.Values  | jsonify -}}