{{- $p := newScratch -}}
{{- $p.Add "title" .Params.title -}}
{{- $p.Add "date" .Params.date -}}
{{- $p.Add "imageid" .Params.imageid -}}
{{- $p.Add "latitude" .Params.point.latitude -}}
{{- $p.Add "longitude" .Params.point.longitude -}}
{{- $p.Add "hasProcessed" .Params.hasProcessed -}}
{{- $p.Add "description" (htmlUnescape .Content) -}}
{{- $p.SetInMap "image" "original" (printf "%s%s/%s.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- if .Params.hasProcessed -}}
{{- $p.SetInMap "image" "large" (printf "%s%s/edited/%s_l.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $p.SetInMap "image" "medium" (printf "%s%s/edited/%s_m.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $p.SetInMap "image" "small" (printf "%s%s/edited/%s_s.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $p.SetInMap "image" "thumbnail" (printf "%s%s/edited/%s_t.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- else -}}
{{- $p.SetInMap "image" "large" (printf "%s%s/%s_l.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $p.SetInMap "image" "medium" (printf "%s%s/%s_m.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $p.SetInMap "image" "small" (printf "%s%s/%s_s.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- $p.SetInMap "image" "thumbnail" (printf "%s%s/%s_t.jpg" site.Params.SIGNBASEURL .Params.imageid .Params.imageid ) -}}
{{- end -}}
{{- with .Params.county -}}
{{- $countypath := printf "/%s/%s" "county" . -}}
{{- with $.Site.GetPage $countypath -}}
{{- $c := dict "name" .Params.name "slug" .Params.slug "url" (printf "%s%s" .Permalink "index.json") -}}
{{- $p.Add "stateSubdivision" $c -}}
{{- end -}}
{{- end -}}
{{- with .Params.place -}}
{{ $placepath := printf "/%s/%s" "place" .}}
{{- with $.Site.GetPage $placepath -}}
{{- $pl := dict "name" .Params.name "slug" .Params.slug "url" (printf "%s%s" .Permalink "index.json") -}}
{{- $p.Add "place" $pl -}}
{{- end -}}
{{- end -}}
{{- range .Params.highway -}}
{{ $highwaypath := printf "/%s/%s" "highway" . }}
{{- with $.Site.GetPage $highwaypath -}}
{{- $hw := dict "imageName" .Params.imageName "name" .Params.name "slug" .Params.slug "url" (printf "%s%s" .Permalink "index.json") -}}
{{- $p.Add "highways" (slice $hw) -}}
{{- end -}}
{{- end -}}
{{- with .Params.state -}}
{{- $statepath := printf "/%s/%s" "state" . -}}
{{- with $.Site.GetPage $statepath -}}
{{- $st := dict "name" .Params.name "slug" .Params.slug "url" (printf "%s%s" .Permalink "index.json") -}}
{{- $p.Add "state" $st -}}
{{- end -}}
{{- end -}}

{{- $p.Values  | jsonify -}}